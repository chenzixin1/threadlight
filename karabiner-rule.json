{
  "title": "FEKER Alice80 Codex task slots",
  "rules": [
    {
      "description": "FEKER Codex Bridge: Option + 1-9 opens the matching lit task",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "shell_command": "'/Applications/Feker Codex Bridge.app/Contents/MacOS/FekerCodexBridge' --open-slot 1"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "vendor_id": 12815, "product_id": 20565 }]
            }
          ]
        },
        {
          "type": "basic",
